BOT_TOKEN=123456:ABC-your-bot-token
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Render ka link (bina / ke). Khali chhodo to Render ka RENDER_EXTERNAL_URL use hoga
BASE_URL=https://your-app.onrender.com
# Extra domains (comma se). Path: sites.pages.dev  |  Wildcard: *.mydomain.com
EXTRA_DOMAINS=
ADMIN_ID=123456789
DEV_NAME=Aditya
DEV_USERNAME=your_telegram_username
MAX_SITES=10
MAX_FILE_MB=1
# Site cache seconds (memory + browser + Cloudflare)
CACHE_SECONDS=60
# 0 = nayi site par admin ko alert band
NOTIFY_ADMIN=1
# 0 = self-ping band
KEEP_ALIVE=1
